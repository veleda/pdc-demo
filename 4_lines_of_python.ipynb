    "import polars as pl\n",
    "from maplib import Model\n",
    "\n",
    "m = Model()\n",
    "tpl = m.map_default(pl.read_csv(\"data/bands_with_iri.csv\"), \"iri\")\n",
    "df = m.query(\"\"\" SELECT * WHERE {?s ?p ?o}\"\"\")\n",
    "df"
